#!/bin/sh
# Copy the staged blueprint into the box's volume; print what changed, nothing when unchanged.
# Rootless volume files belong to mapped ids that only `podman unshare` can write. Why: 0002-the-box design D8.
set -eu
staging={{ box_config }}/{{ box.name }}/blueprint
data=$(podman volume inspect --format '{% raw %}{{ .Mountpoint }}{% endraw %}' {{ box.name }}-data)
# The staged entries, not the staging root, and no directory times: the agent writes into the volume root
# and its directories, and neither may read as a blueprint change.
podman unshare sh -c '
  set -eu
  dst=$1
  cd "$2"
  set --
  for f in * .[!.]*; do
    if [ -e "$f" ]; then set -- "$@" "$f"; fi
  done
  [ $# -gt 0 ] || exit 0
  out=$(rsync -a --omit-dir-times --checksum --itemize-changes --no-owner --no-group -- "$@" "$dst/")
  [ -n "$out" ] || exit 0
  printf "%s\n" "$out"
  for f in "$@"; do
    chown -R 10000:10000 "$dst/$f"
  done
' sh "$data" "$staging"
