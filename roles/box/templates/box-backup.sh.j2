#!/bin/bash
# Archive the running box, encrypt it to the recipients, upload it, keep the newest five.
# Why no stop: 0004-the-handover design D5. Run by root from /etc/cron.d/box-{{ box.name }}.
set -euo pipefail
[ "${1:-}" = "{{ box.name }}" ] || { echo "usage: box-backup {{ box.name }}" >&2; exit 2; }

{% set zip = manifest.blueprint_mount ~ '/backups/agent-iac.zip' %}
{% set remote = 'r2:' ~ box_r2_bucket %}
# The box user owns the container, the volume and the rclone env, so it runs every step.
job=$(cat <<'BOX'
set -euo pipefail
export XDG_RUNTIME_DIR=/run/user/$(id -u)
set -a; . {{ box_rclone_env }}; set +a
fail() { logger -p user.err -t box-backup "{{ box.name }}: $1"; exit 1; }
# The plaintext zip lives only in the volume, and only until the script exits.
trap 'podman exec --user 10000 {{ box.name }} rm -f {{ zip }} || true' EXIT

archive={{ box.name }}-$(date -u +%Y%m%dT%H%M%SZ).zip.age
podman exec --user 10000 {{ box.name }} {{ manifest.backup | map('replace', '{archive}', zip) | map('quote') | join(' ') }} ||
  fail "the archive failed"
data=$(podman volume inspect --format '{% raw %}{{ .Mountpoint }}{% endraw %}' {{ box.name }}-data) ||
  fail "no volume {{ box.name }}-data"
podman unshare cat "$data/backups/agent-iac.zip" | age -R {{ box_recipients_file }} |
  rclone rcat "{{ remote }}/$archive" || fail "the upload of $archive failed"

# The names sort by time; a delete the bucket's lock refuses is the lock working.
rclone lsf --files-only --include '{{ box.name }}-*.zip.age' {{ remote }} | sort -r | tail -n +6 |
  while read -r old; do
    rclone deletefile "{{ remote }}/$old" ||
      logger -p user.warning -t box-backup "{{ box.name }}: the bucket kept $old"
  done || fail "the listing of {{ remote }} failed"
BOX
)
exec su - {{ box_user }} -s /bin/bash -c "$job"
