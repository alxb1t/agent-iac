# The agent's ssh config: its home is /opt/data. git-hook replaces the quadlet's GIT_SSH_COMMAND with its own,
# so every ssh to GitHub, the plugin's pulls and pushes too, takes the deploy key and the pinned host keys here.
# Why: 0003-the-knowledge-base design D5.
Host github.com
  IdentityFile /run/secrets/kb_deploy_key
  IdentitiesOnly yes
  StrictHostKeyChecking yes
  UserKnownHostsFile /opt/data/.ssh/kb_known_hosts
  GlobalKnownHostsFile /dev/null
